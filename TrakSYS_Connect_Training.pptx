var r = new Result<InterfaceFilePullPostModelLoadedInfo<PdPo>>();
var info = context.CreateInfoObject();

var jobModel3 = new ETS.Core.Api.Models.Data.DbJobDiscreteComposite();
jobModel3.Name = info.MessageModel.name;
jobModel3.ExternalID = info.MessageModel.name;
jobModel3.Description = info.MessageModel.description;
jobModel3.Notes = "Created Via Interface Plugin Script";
jobModel3.Capture01 = context.InterfaceTransactionID.ToVariantString();         
jobModel3.Capture02 = info.MessageModel.product; //product
jobModel3.Capture03 = info.MessageModel.quantity.ToVariantString(); //order qty

context.Api.Data.DbJobDiscreteComposite.Save.InsertAsNew(jobModel3).ThrowIfFailed();

return r.AsSuccess(info);


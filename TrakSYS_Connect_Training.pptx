var r = new Result<InterfaceFilePullPostModelLoadedInfo<List<PdArea>>>();
var info = context.CreateInfoObject();

foreach (PdArea entity in info.MessageModel) {
	var areaModel = new ETS.Core.Api.Models.Data.DbArea();  

	areaModel.SiteID = entity.siteId;
	areaModel.Name = entity.areaName;
	areaModel.AltName = entity.areaId.ToVariantString();

	context.Api.Data.DbArea.Save.InsertAsNew(areaModel).ThrowIfFailed();
}

return r.AsSuccess(info);

